# Qual ambiente o "docker compose" sobe: a base mais o arquivo de desenvolvimento ou o de produção.
# Com esta linha, basta "docker compose up"; sem ela, passe os dois arquivos com -f.
COMPOSE_FILE=compose.yaml:compose.dev.yaml
# COMPOSE_FILE=compose.yaml:compose.prod.yaml

DEBUG=True
SECRET_KEY=sua-secret-key-aqui
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Só produção (compose.prod.yaml) --------------------------------------------
# Obrigatórios: SECRET_KEY longa e aleatória acima, ALLOWED_HOSTS com o seu domínio, e:
# POSTGRES_PASSWORD=
# CSRF_TRUSTED_ORIGINS=https://agentes.exemplo.com
# Opcionais:
# WEB_BIND=127.0.0.1:8000     endereço em que a web escuta na máquina (o proxy com HTTPS aponta para cá)
# WEB_WORKERS=3               processos do gunicorn
# SIGNUP_OPEN=False           criação de conta pela tela; fechada em produção por padrão
# SECURE_COOKIES=True         desligue só para acessar produção por http, sem proxy com HTTPS
# ---------------------------------------------------------------------------------

# Banco e fila. Dentro do Docker estes três são definidos pelo compose e os valores abaixo são
# ignorados; eles valem ao rodar manage.py direto na máquina, com Postgres e Redis no Docker.
DATABASE_URL=postgres://izzyone:izzyone@localhost:5432/izzyone
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# E-mail (em desenvolvimento vai para o Mailpit; em produção, aponte para o seu servidor SMTP)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@localhost

# Chaves dos provedores de LLM usados pelos agentes (preencha só os que for usar).
# Também podem ser cadastradas pela tela de Integrações; a chave salva lá vale antes destas.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Opcional. O acesso aos repositórios é pela chave SSH de cada projeto, mostrada na tela do projeto.
# Com este token os agentes também abrem o pull request sozinhos, em vez de entregar o link para você abrir.
GITHUB_TOKEN=

# Limites das execuções
CELERY_WORKER_CONCURRENCY=2
RUN_MAX_TOKENS=2000000
WORKSPACE_RETENTION_DAYS=7

# Os comandos rodados pelos agentes não enxergam as variáveis deste arquivo. Para liberar alguma, liste os
# nomes aqui, separados por vírgula.
TOOL_ENV_PASSTHROUGH=
