DEBUG=True
SECRET_KEY=sua-secret-key-aqui
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco e fila (padrão: Postgres e Redis locais, via docker compose up -d)
DATABASE_URL=postgres://izzyone:izzyone@localhost:5432/izzyone
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# E-mail (padrão: Mailpit local, via docker compose up -d)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@localhost

# Chaves dos provedores de LLM usados pelos agentes (preencha só os que for usar)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
