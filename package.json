{
  "private": true,
  "scripts": {
    "build": "npm run css:build && npm run js:build",
    "css:build": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --minify",
    "css:watch": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --watch",
    "js:build": "cp ./node_modules/flowbite/dist/flowbite.min.js ./node_modules/flowbite/dist/flowbite.min.js.map ./static/js/"
  },
  "dependencies": {
    "flowbite": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
